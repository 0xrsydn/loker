{
  "$defs": {
    "Eligibility": {
      "description": "Eligibility as stored and served: the axes plus the derived `scope`. Rows\nstored before the axes existed have only `scope`; they read as it says.",
      "properties": {
        "confidence": {
          "format": "double",
          "type": "number"
        },
        "countries": {
          "default": [],
          "description": "ISO 3166-1 alpha-2 codes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "elsewhere": {
          "anyOf": [
            {
              "$ref": "#/$defs/Elsewhere"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "onsiteCity": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "description": "Original location text, kept for the evidence trail.",
          "type": [
            "string",
            "null"
          ]
        },
        "regions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "description": "Derived from the fields below; kept for earlier clients."
        },
        "tz": {
          "anyOf": [
            {
              "$ref": "#/$defs/TzWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "workplace": {
          "anyOf": [
            {
              "$ref": "#/$defs/Workplace"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "scope",
        "confidence",
        "method"
      ],
      "type": "object"
    },
    "Elsewhere": {
      "description": "What the posting says about people outside its places. A list of places\nis not always a limit: \"USA Only\" is, an employer's office on a remote job\nisn't. Gray information gets its own value instead of a guess.",
      "oneOf": [
        {
          "const": "excluded",
          "description": "Only the listed places (\"USA Only\", \"must reside in Germany\").",
          "type": "string"
        },
        {
          "const": "not_stated",
          "description": "Places are listed, nothing is said about anyone else.",
          "type": "string"
        },
        {
          "const": "open",
          "description": "Open beyond them (\"worldwide\", \"or wherever you are\").",
          "type": "string"
        }
      ]
    },
    "Experience": {
      "description": "Years of experience a job requires.",
      "properties": {
        "evidence": {
          "description": "The phrase it was read from.",
          "type": "string"
        },
        "maxYears": {
          "description": "The upper end, when the posting gives a range (\"3-5 years\").",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "method": {
          "$ref": "#/$defs/ExperienceMethod"
        },
        "minYears": {
          "description": "Minimum years required; 0 when the posting says none is needed.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "minYears",
        "method",
        "evidence"
      ],
      "type": "object"
    },
    "ExperienceMethod": {
      "oneOf": [
        {
          "const": "source",
          "description": "The source's own field (Y Combinator's \"minimum experience\").",
          "type": "string"
        },
        {
          "const": "description",
          "description": "Read from the description.",
          "type": "string"
        }
      ]
    },
    "JobRole": {
      "description": "A job's role, and why it has it. A job no step could place has no\n`JobRole` at all, rather than an \"other\" role.",
      "properties": {
        "confidence": {
          "format": "double",
          "type": "number"
        },
        "evidence": {
          "description": "What decided it, e.g. \"title: Forward Deployed Infrastructure Engineer\".",
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "$ref": "#/$defs/RoleMethod"
        },
        "modifiers": {
          "items": {
            "$ref": "#/$defs/Modifier"
          },
          "type": "array"
        },
        "primary": {
          "$ref": "#/$defs/Role",
          "description": "The most specific id found: a role, or a family when that is all the\nevidence says."
        },
        "secondary": {
          "description": "Other roles the job also fills, at most [`MAX_ROLES`] - 1\n(\"Backend / Infrastructure Engineer\").",
          "items": {
            "$ref": "#/$defs/Role"
          },
          "type": "array"
        },
        "version": {
          "description": "The vocabulary [`VERSION`] it was classified with.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "primary",
        "method",
        "confidence",
        "version"
      ],
      "type": "object"
    },
    "JobSource": {
      "properties": {
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "url"
      ],
      "type": "object"
    },
    "Method": {
      "enum": [
        "source",
        "rules",
        "jev"
      ],
      "type": "string"
    },
    "Modifier": {
      "description": "How a job is done, whatever its role.",
      "oneOf": [
        {
          "const": "forward_deployed",
          "description": "Works with customers, on site or embedded, building for their problems.",
          "type": "string"
        },
        {
          "const": "founding",
          "description": "Among a company's first hires.",
          "type": "string"
        }
      ]
    },
    "Money": {
      "description": "An amount of money: one figure (`min == max`), a range, or one end of it\n(\"up to\" fills only `max`, \"from\" only `min`). At least one end is set,\nboth are positive, and `min <= max`.",
      "properties": {
        "currency": {
          "description": "ISO 4217 code, e.g. \"USD\", \"EUR\".",
          "type": "string"
        },
        "label": {
          "description": "What this range is for when a posting gives several: a level\n(\"Senior Strategic Project Lead\") or a location (\"UK\").",
          "type": [
            "string",
            "null"
          ]
        },
        "max": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/Period"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the amount is paid per. Always set for base pay; absent for a\none-off sum (a sign-on bonus, an equity grant)."
        }
      },
      "required": [
        "currency"
      ],
      "type": "object"
    },
    "Pay": {
      "description": "Pay as the posting states it. Absent when the posting says nothing usable;\n\"competitive\" or \"DOE\" is not pay. Nothing is guessed: a figure is kept\nonly with its currency (and, for base pay, its period), and a figure that\nfails a check is dropped, not kept wrong (see `normalize::money`).",
      "properties": {
        "base": {
          "default": [],
          "description": "Base pay: salary or wage, as stated, in its own currency. Usually one\nrange; one per level or location when the posting gives several.\nEmpty when only extras are stated (\"competitive salary + equity\").",
          "items": {
            "$ref": "#/$defs/Money"
          },
          "type": "array"
        },
        "extras": {
          "default": [],
          "description": "Equity, bonus, commission and the like, one per kind, with figures\nwhen stated.",
          "items": {
            "$ref": "#/$defs/PayExtra"
          },
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/PayMethod",
          "default": "source"
        },
        "raw": {
          "description": "Pay as text: the source's own summary, or one written from its fields.",
          "type": "string"
        },
        "usdMonthMax": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "usdMonthMin": {
          "description": "Base pay in USD per month, for comparing jobs: the lowest and highest\nfigures across `base`. Only from USD amounts for now.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "raw"
      ],
      "type": "object"
    },
    "PayExtra": {
      "description": "Pay on top of the base.",
      "properties": {
        "amount": {
          "anyOf": [
            {
              "$ref": "#/$defs/Money"
            },
            {
              "type": "null"
            }
          ],
          "description": "When stated as money (\"$1M in equity\", \"$20K sign-on\")."
        },
        "kind": {
          "$ref": "#/$defs/PayExtraKind"
        },
        "percent": {
          "anyOf": [
            {
              "$ref": "#/$defs/Percent"
            },
            {
              "type": "null"
            }
          ],
          "description": "When stated as a percentage: of the company for equity (\"0.25%–1%\"),\nof base pay for a bonus (\"10–15%\")."
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "PayExtraKind": {
      "oneOf": [
        {
          "enum": [
            "bonus",
            "commission",
            "sign_on"
          ],
          "type": "string"
        },
        {
          "const": "equity",
          "description": "Shares, options, RSUs or tokens.",
          "type": "string"
        },
        {
          "const": "ote",
          "description": "On-target earnings: base plus commission at target, as sales roles\nstate it.",
          "type": "string"
        }
      ]
    },
    "PayMethod": {
      "description": "Where pay came from.",
      "oneOf": [
        {
          "const": "source",
          "description": "The source's own pay fields.",
          "type": "string"
        },
        {
          "const": "text",
          "description": "Read from the description; `raw` is the text it came from.",
          "type": "string"
        }
      ]
    },
    "Percent": {
      "description": "A percentage or a range of them, under the same rules as [`Money`].",
      "properties": {
        "max": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "min": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Period": {
      "enum": [
        "hour",
        "day",
        "week",
        "month",
        "year"
      ],
      "type": "string"
    },
    "Role": {
      "description": "A family (`engineering`) or a role in one (`backend`). The list is open:\nit grows, and clients must accept ids they don't know.",
      "enum": [
        "engineering",
        "ai",
        "data",
        "product",
        "design",
        "go_to_market",
        "support",
        "operations",
        "ai_training",
        "education",
        "healthcare",
        "software",
        "backend",
        "frontend",
        "fullstack",
        "product_engineer",
        "mobile",
        "infrastructure",
        "security",
        "qa",
        "embedded",
        "hardware",
        "technical_writing",
        "engineering_management",
        "design_engineer",
        "devrel",
        "ai_engineering",
        "ml_engineering",
        "ml_infrastructure",
        "research",
        "data_engineering",
        "data_science",
        "data_analysis",
        "product_management",
        "program_management",
        "product_design",
        "ux_research",
        "brand_design",
        "sales",
        "marketing",
        "product_marketing",
        "sales_engineering",
        "customer_success",
        "customer_support",
        "technical_support",
        "business_operations",
        "finance",
        "legal",
        "compliance",
        "people",
        "recruiting",
        "it",
        "admin"
      ],
      "type": "string"
    },
    "RoleMethod": {
      "description": "Where a job's role came from, most trusted first.",
      "oneOf": [
        {
          "const": "title",
          "description": "A phrase in the title.",
          "type": "string"
        },
        {
          "const": "category",
          "description": "The source's own category or department.",
          "type": "string"
        },
        {
          "const": "description",
          "description": "A phrase in the description.",
          "type": "string"
        },
        {
          "const": "model",
          "description": "A model choosing from this vocabulary.",
          "type": "string"
        }
      ]
    },
    "Scope": {
      "description": "The eligibility summary every contract version has carried, derived from\n`workplace`, the places and `elsewhere` (see [`Eligibility::scope`]).",
      "enum": [
        "worldwide",
        "region",
        "countries",
        "onsite",
        "hybrid",
        "unknown"
      ],
      "type": "string"
    },
    "SearchHit": {
      "description": "A stored job, as functions return it.",
      "properties": {
        "company": {
          "type": "string"
        },
        "eligibility": {
          "$ref": "#/$defs/Eligibility"
        },
        "eligible": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "description": "Verdict for the viewer in `country`/`tz`; absent when no country was given."
        },
        "employmentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "experience": {
          "anyOf": [
            {
              "$ref": "#/$defs/Experience"
            },
            {
              "type": "null"
            }
          ],
          "description": "Years of experience required, from the source's field or the\ndescription; absent when neither states a number."
        },
        "firstSeen": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "partial": {
          "description": "Matches only some of the query words.",
          "type": "boolean"
        },
        "pay": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pay"
            },
            {
              "type": "null"
            }
          ]
        },
        "postedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobRole"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the job is: its role in the vocabulary of `list_roles`, how it\nwas decided, and modifiers (forward deployed, founding). Absent when\nnothing in the title, category or description places it."
        },
        "seniority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seniority"
            },
            {
              "type": "null"
            }
          ],
          "description": "From the title when it names a level, else as the source states it;\nabsent when neither does."
        },
        "sources": {
          "description": "Every source that lists this job, with its page there (for attribution).",
          "items": {
            "$ref": "#/$defs/JobSource"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        },
        "techTags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "visa": {
          "anyOf": [
            {
              "$ref": "#/$defs/Visa"
            },
            {
              "type": "null"
            }
          ],
          "description": "Visa sponsorship, read from the description; absent when it says nothing."
        }
      },
      "required": [
        "id",
        "title",
        "company",
        "eligibility",
        "techTags",
        "url",
        "firstSeen",
        "status",
        "sources"
      ],
      "type": "object"
    },
    "Seniority": {
      "description": "Career level, lowest first.",
      "oneOf": [
        {
          "enum": [
            "intern",
            "junior",
            "mid",
            "senior"
          ],
          "type": "string"
        },
        {
          "const": "lead",
          "description": "Lead, staff or principal.",
          "type": "string"
        },
        {
          "const": "executive",
          "description": "Head of, director, VP, C-level.",
          "type": "string"
        }
      ]
    },
    "Sponsorship": {
      "oneOf": [
        {
          "const": "offered",
          "description": "The employer sponsors a visa or work permit, or supports the hire's\nimmigration process.",
          "type": "string"
        },
        {
          "const": "limited",
          "description": "Only in some cases: \"may\", \"case by case\", transfers only, or only in\nsome of the posting's locations.",
          "type": "string"
        },
        {
          "const": "not_offered",
          "description": "The employer won't sponsor, or the hire must not need sponsorship.",
          "type": "string"
        }
      ]
    },
    "TzStrength": {
      "enum": [
        "required",
        "preferred"
      ],
      "type": "string"
    },
    "TzWindow": {
      "description": "Allowed UTC offsets as a window in hours, e.g. `+1.0 ..= +7.0`.\nThe window may wrap around the date line (`from > to`).",
      "properties": {
        "from": {
          "format": "double",
          "type": "number"
        },
        "strength": {
          "$ref": "#/$defs/TzStrength"
        },
        "to": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "from",
        "to",
        "strength"
      ],
      "type": "object"
    },
    "Verdict": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/VerdictKind"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "type": "object"
    },
    "VerdictKind": {
      "enum": [
        "yes",
        "maybe",
        "unknown",
        "no"
      ],
      "type": "string"
    },
    "Visa": {
      "description": "Visa sponsorship as the posting states it. Absent when it says nothing:\n\"must be authorized to work in the US\" alone, a citizenship or clearance\nrequirement, or an equal opportunity statement says nothing about it.",
      "properties": {
        "evidence": {
          "description": "The sentence it was read from.",
          "type": "string"
        },
        "sponsorship": {
          "$ref": "#/$defs/Sponsorship"
        }
      },
      "required": [
        "sponsorship",
        "evidence"
      ],
      "type": "object"
    },
    "Workplace": {
      "description": "Whether the job is done remotely, as the posting or board says.",
      "oneOf": [
        {
          "enum": [
            "remote",
            "hybrid",
            "onsite"
          ],
          "type": "string"
        },
        {
          "const": "unknown",
          "description": "Not stated: a city or country alone may be an office.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "contractVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "jobs": {
      "description": "The jobs found, in the order asked for, closed ones included (see `status`).",
      "items": {
        "$ref": "#/$defs/SearchHit"
      },
      "type": "array"
    },
    "missing": {
      "description": "Ids that match no job.",
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "contractVersion",
    "jobs",
    "missing"
  ],
  "title": "GetJobsResult",
  "type": "object"
}
