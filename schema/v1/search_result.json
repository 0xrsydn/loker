{
  "$defs": {
    "CompactHit": {
      "description": "Just enough of a job to choose it.",
      "properties": {
        "company": {
          "type": "string"
        },
        "eligible": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "description": "Verdict for the viewer in `country`/`tz`; absent when no country was given."
        },
        "id": {
          "type": "string"
        },
        "partial": {
          "description": "Matches only some of the query words.",
          "type": "boolean"
        },
        "pay": {
          "description": "The source's pay text, e.g. \"USD 50–100 hourly\".",
          "type": [
            "string",
            "null"
          ]
        },
        "postedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "$ref": "#/$defs/Scope",
          "description": "Eligibility scope: worldwide, regions, countries, hybrid, onsite, unknown."
        },
        "seniority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seniority"
            },
            {
              "type": "null"
            }
          ],
          "description": "Career level, when the title or source names one."
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "company",
        "url",
        "scope"
      ],
      "type": "object"
    },
    "Eligibility": {
      "properties": {
        "confidence": {
          "format": "double",
          "type": "number"
        },
        "countries": {
          "default": [],
          "description": "ISO 3166-1 alpha-2 codes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "$ref": "#/$defs/Method"
        },
        "onsiteCity": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw": {
          "description": "Original location text, kept for the evidence trail.",
          "type": [
            "string",
            "null"
          ]
        },
        "regions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "tz": {
          "anyOf": [
            {
              "$ref": "#/$defs/TzWindow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "confidence",
        "method"
      ],
      "type": "object"
    },
    "Hit": {
      "anyOf": [
        {
          "$ref": "#/$defs/SearchHit"
        },
        {
          "$ref": "#/$defs/CompactHit"
        },
        {
          "$ref": "#/$defs/TitleHit"
        }
      ],
      "description": "A job in a search result: full, or compact."
    },
    "JobSource": {
      "properties": {
        "source": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "url"
      ],
      "type": "object"
    },
    "Method": {
      "enum": [
        "source",
        "rules",
        "jev"
      ],
      "type": "string"
    },
    "Pay": {
      "properties": {
        "raw": {
          "type": "string"
        },
        "usdMonthMax": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "usdMonthMin": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "raw"
      ],
      "type": "object"
    },
    "Scope": {
      "enum": [
        "worldwide",
        "region",
        "countries",
        "onsite",
        "hybrid",
        "unknown"
      ],
      "type": "string"
    },
    "SearchHit": {
      "description": "A stored job, as functions return it.",
      "properties": {
        "company": {
          "type": "string"
        },
        "eligibility": {
          "$ref": "#/$defs/Eligibility"
        },
        "eligible": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verdict"
            },
            {
              "type": "null"
            }
          ],
          "description": "Verdict for the viewer in `country`/`tz`; absent when no country was given."
        },
        "employmentType": {
          "type": [
            "string",
            "null"
          ]
        },
        "firstSeen": {
          "format": "date-time",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "partial": {
          "description": "Matches only some of the query words.",
          "type": "boolean"
        },
        "pay": {
          "anyOf": [
            {
              "$ref": "#/$defs/Pay"
            },
            {
              "type": "null"
            }
          ]
        },
        "postedAt": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        },
        "seniority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seniority"
            },
            {
              "type": "null"
            }
          ],
          "description": "From the title when it names a level, else as the source states it;\nabsent when neither does."
        },
        "sources": {
          "description": "Every source that lists this job, with its page there (for attribution).",
          "items": {
            "$ref": "#/$defs/JobSource"
          },
          "type": "array"
        },
        "status": {
          "type": "string"
        },
        "techTags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "company",
        "eligibility",
        "techTags",
        "url",
        "firstSeen",
        "status",
        "sources"
      ],
      "type": "object"
    },
    "Seniority": {
      "description": "Career level, lowest first.",
      "oneOf": [
        {
          "enum": [
            "intern",
            "junior",
            "mid",
            "senior"
          ],
          "type": "string"
        },
        {
          "const": "lead",
          "description": "Lead, staff or principal.",
          "type": "string"
        },
        {
          "const": "executive",
          "description": "Head of, director, VP, C-level.",
          "type": "string"
        }
      ]
    },
    "TitleHit": {
      "description": "The least needed to scan a list: open the picks with `get_jobs`.",
      "properties": {
        "company": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "partial": {
          "description": "Matches only some of the query words.",
          "type": "boolean"
        },
        "seniority": {
          "anyOf": [
            {
              "$ref": "#/$defs/Seniority"
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/VerdictKind"
            },
            {
              "type": "null"
            }
          ],
          "description": "The viewer's verdict (reason omitted); absent when no country was given."
        }
      },
      "required": [
        "id",
        "title",
        "company"
      ],
      "type": "object"
    },
    "TzStrength": {
      "enum": [
        "required",
        "preferred"
      ],
      "type": "string"
    },
    "TzWindow": {
      "description": "Allowed UTC offsets as a window in hours, e.g. `+1.0 ..= +7.0`.\nThe window may wrap around the date line (`from > to`).",
      "properties": {
        "from": {
          "format": "double",
          "type": "number"
        },
        "strength": {
          "$ref": "#/$defs/TzStrength"
        },
        "to": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "from",
        "to",
        "strength"
      ],
      "type": "object"
    },
    "Verdict": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/VerdictKind"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "type": "object"
    },
    "VerdictKind": {
      "enum": [
        "yes",
        "maybe",
        "unknown",
        "no"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "contractVersion": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "count": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "fullMatches": {
      "description": "Of `total`, the jobs with every query word (the rest are `partial`).\n0 means no job has all the words. Equals `total` when `q` is empty.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "jobs": {
      "description": "Each job as a `SearchHit`, a `CompactHit` (`view: compact`) or a\n`TitleHit` (`view: titles`).",
      "items": {
        "$ref": "#/$defs/Hit"
      },
      "type": "array"
    },
    "nextOffset": {
      "description": "Pass as `offset` to get the next page; absent when this page is the last.",
      "format": "uint32",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "total": {
      "description": "Jobs matching every filter, across all pages.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "contractVersion",
    "count",
    "total",
    "fullMatches",
    "jobs"
  ],
  "title": "SearchResult",
  "type": "object"
}
